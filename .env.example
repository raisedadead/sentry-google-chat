# --- Sentry ---
# Client Secret of your Sentry Internal Integration. Used to verify the
# Sentry-Hook-Signature on every incoming webhook (HMAC-SHA256 of the raw body).
SENTRY_CLIENT_SECRET=your-sentry-internal-integration-client-secret

# Optional: DSN so this service reports its OWN errors to Sentry (dogfooding).
SENTRY_DSN=

# --- Google Chat routing ---
# Fallback Google Chat Incoming Webhook URL used when a Sentry project slug
# has no explicit route. Treat as a SECRET (key + token grant full post access).
GCHAT_WEBHOOK_DEFAULT=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN

# Optional: JSON map of Sentry project slug -> Google Chat Incoming Webhook URL.
# Alerts from a matching project are routed to that space; others fall back to
# GCHAT_WEBHOOK_DEFAULT. Example:
# GCHAT_ROUTES={"api-prod":"https://chat.googleapis.com/v1/spaces/AAA/messages?key=...&token=...","web":"https://chat.googleapis.com/v1/spaces/BBB/messages?key=...&token=..."}
GCHAT_ROUTES=

# --- Server ---
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
