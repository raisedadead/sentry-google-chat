{
  "name": "sentry-google-chat",
  "version": "1.0.0",
  "description": "Forward Sentry alerts to Google Chat (Google Workspace) spaces",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "sentry",
    "google-chat",
    "google-workspace",
    "webhook",
    "alerts",
    "integration"
  ],
  "author": "Mrugesh Mohapatra <aichat@mrugesh.dev>",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raisedadead/sentry-google-chat.git"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@sentry/node": "10.55.0",
    "hono": "4.12.30",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
